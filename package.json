{
  "name": "dsh-plugin-usage-stats",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin for AI usage & cost intelligence: token totals, cost estimation ($/¥), cache savings, 5-way token composition, 365-day activity heatmap, 30-day token trend, model breakdown, top sessions leaderboard, and tool analytics.",
  "type": "module",
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "smoke:client": "node scripts/client-smoke.mjs",
    "test": "node scripts/smoke.mjs && node scripts/client-smoke.mjs",
    "build": "node -c index.js && node -c client.js"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "usage",
    "statistics",
    "cost",
    "pricing",
    "tokens",
    "settings",
    "context"
  ],
  "author": "kola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolawong/dsh-plugin-usage-stats.git"
  },
  "bugs": {
    "url": "https://github.com/kolawong/dsh-plugin-usage-stats/issues"
  },
  "homepage": "https://github.com/kolawong/dsh-plugin-usage-stats#readme",
  "license": "MIT",
  "files": [
    "index.js",
    "pricing.js",
    "client.js",
    "index.d.ts",
    "cordis.patch.yml",
    "preview.png",
    "README.md",
    "README_CN.md",
    "LICENSE",
    "scripts/",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  }
}
